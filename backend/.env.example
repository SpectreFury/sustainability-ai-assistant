# Use the connection URLs provided by your hosted Postgres and Redis services.
DATABASE_URL=postgresql+asyncpg://user:password@your-postgres-host:5432/database
JWT_SECRET_KEY=
JWT_COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REDIS_URL=rediss://default:password@your-redis-host:6379/0
REDIS_UNACKNOWLEDGED_IDLE_MS=600000
REDIS_UNACKNOWLEDGED_LOCK_TIMEOUT_SECONDS=30
EXTRACTION_RUN_LEASE_SECONDS=120
EXTRACTION_RUN_HEARTBEAT_SECONDS=30
GEMINI_API_KEY=
DOCUMENT_EXTRACTION_MODEL=gemini-3.5-flash-lite
ANSWER_GENERATION_MODEL=gemini-3.5-flash-lite
EXTRACTION_PIPELINE=improved
EXTRACTION_MAX_BYTES=52428800
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# Set false to trace call metadata without sending source text/extracted facts.
LANGFUSE_CAPTURE_CONTENT=true
