      "link": null,
      "locked": false,
      "text": "IMPORTANT BOUNDARY\nThe model does not query Postgres. API code selects the user’s facts and source evidence with SQL.\nServer code verifies citations and performs arithmetic / Indian FY aggregation. No vector search in the answer path.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "3979354bf8025496cf73",
      "originalText": "IMPORTANT BOUNDARY\nThe model does not query Postgres. API code selects the user’s facts and source evidence with SQL.\nServer code verifies citations and performs arithmetic / Indian FY aggregation. No vector search in the answer path.",
      "autoResize": false,
      "lineHeight": 1.25
    },
