# Use the connection URLs provided by your hosted Postgres and Redis services.
DATABASE_URL=postgresql+asyncpg://user:password@your-postgres-host:5432/database
REDIS_URL=rediss://default:password@your-redis-host:6379/0
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_COOKIE_SECURE=false
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Required for document upload and extraction
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
DOCUMENT_EXTRACTION_MODEL=gemini-3.5-flash-lite
ANSWER_GENERATION_MODEL=gemini-3.5-flash-lite
EXTRACTION_PIPELINE=improved
EXTRACTION_MAX_BYTES=52428800

# Optional observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_CAPTURE_CONTENT=true
